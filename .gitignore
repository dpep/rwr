/target
**/*.rs.bk
.DS_Store

# Scratch space. `tmp/rules-unshipped` holds rules the pack deliberately does
# not carry -- safe where you know the receivers, not safe to ship.
/tmp

# Local release config: machine-specific paths, and it names a private
# marketplace. `release` sources it from the repo root; it is not shipped.
.release.conf

# Agent worktrees; `script/commit.sh` does `git add -A` and would commit these as gitlinks.
.claude/worktrees/

# The testing arc's working notes: reports, matrices, salvaged logs. Kept in the
# repo so the next session finds them beside the code, deliberately out of
# history -- they are scratch, and the conclusions live in decisions.md and the
# changelog. Their first home was the session scratchpad under /private/tmp,
# which gets purged; most of the arc's reports were lost that way.
research/
